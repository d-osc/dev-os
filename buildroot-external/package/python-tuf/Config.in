config BR2_PACKAGE_PYTHON_TUF
	bool "python-tuf"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_PYTHON_SECURESYSTEMSLIB
	select BR2_PACKAGE_PYTHON_URLLIB3
	select BR2_PACKAGE_PYTHON_PACKAGING
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON3_HASHLIB
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_PYTHON_PYELFTOOLS
	help
	  Pinned verification runtime for Dev OS package repositories.
